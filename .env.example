# =============================================================================
# RedSea GPT - environment configuration template
# =============================================================================
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# NEVER commit your real .env. It is gitignored. Never paste real keys into
# issues, README, screenshots, or logs.
# =============================================================================

# --- LLM provider ----------------------------------------------------------
# Which backend to use. Auto-detected from which *_API_KEY is set if omitted.
# Valid: optillm | groq | openai | openai-compatible
LLM_PROVIDER=optillm

# --- OptiLLM (Anthropic-Messages-compatible gateway, primary) --------------
# Used in the current evaluation. OptiLLM speaks the Anthropic Messages API:
#   POST {OPTO_LLM_BASE_URL}/messages  with header x-api-key
OPTO_LLM_API_KEY=sk-your-optollm-api-key-here
OPTO_LLM_BASE_URL=https://optollm.optomatica.com/v1
# OptiLLM proxies an upstream model. Tested models: gpt-4o-mini, mistral-small
OPTO_LLM_MODEL=gpt-4o-mini

# --- Groq (OpenAI-compatible, historical backend) --------------------------
# Groq speaks the OpenAI Chat Completions API:
#   POST {GROQ_BASE_URL}/chat/completions  with header Authorization: Bearer
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: generic OpenAI-compatible endpoint --------------------------
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Generation defaults (optional) ----------------------------------------
# TEMPERATURE=0.3
# MAX_TOKENS=2048
